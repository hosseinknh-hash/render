# OpenAI API Key — required
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Model used for lead-response drafting/parsing (cheap + fast). Leave default unless you need higher quality.
AI_MODEL=gpt-4o-mini

# --- Lead automation module ---

# Postgres connection string. Free options: https://neon.tech or https://supabase.com
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret your website form (or a Zapier/Make step for Meta Lead Ads) must send as
# the `x-api-key` header when POSTing to /api/leads/intake. Generate any long random string.
LEADS_INTAKE_KEY=

# Basic auth for the staff dashboard at /leads. Leave both blank to leave it open in local dev.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Resend — outbound email. https://resend.com
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Twilio — outbound + inbound SMS. https://www.twilio.com/console
# After deploying, set your Twilio number's "A message comes in" webhook to:
#   https://<your-domain>/api/sms/inbound
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Microsoft Graph — creates the booked call on the designer/manager's Outlook calendar.
# Requires an Azure AD app registration (Microsoft Entra ID) with Application permission
# Calendars.ReadWrite (admin consent granted) — no per-user OAuth login needed.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Mailbox (email address) the booked call events get created on.
OUTLOOK_MAILBOX_USER=

# Fallback assignee recorded on booked call tasks.
DESIGNER_EMAIL=
